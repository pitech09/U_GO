# ─────────────────────────────────────────────────────────────
# RideFlow environment configuration
# Copy this file to `.env` and adjust the values for your setup.
# Never commit your real `.env` file — it is already gitignored.
# ─────────────────────────────────────────────────────────────

# Port for the Express backend (REST API + static landing page).
# Defaults to 5000 if unset.
PORT=5000

# URL the Expo frontend uses to reach the backend at runtime.
# For local development this is your machine + the backend port.
# In production, set this to your deployed backend host (no protocol),
# e.g. EXPO_PUBLIC_DOMAIN=api.yourdomain.com
EXPO_PUBLIC_DOMAIN=localhost:5000

# ── Redis (primary data store) ───────────────────────────────
# The backend auto-starts a local Redis instance on 127.0.0.1:6379
# with append-only-file (AOF) persistence. No configuration is
# required for local development.
# To use an external/managed Redis, update the connection settings
# in `server/storage.ts`.
# Production must use a managed/authenticated Redis URL with persistence,
# backups, replication/failover, and TLS where supported.
# REDIS_URL=rediss://:password@redis.example.com:6380

# ── Optional: PostgreSQL ─────────────────────────────────────
# The core app runs entirely on Redis and does NOT require Postgres.
# A Drizzle/pg layer is scaffolded for teams who want a relational
# store. Uncomment and set this only if you wire it up.
# DATABASE_URL=postgresql://user:password@localhost:5432/rideflow

# ── Authentication ──────────────────────────────────────────
# Required in production. Use a long random secret and never commit it.
SESSION_SECRET=replace-with-a-long-random-secret
# Required when seeding a new production Redis database. There is no default admin password.
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
# ACCESS_TOKEN_TTL_SECONDS=604800

# ── Payments ────────────────────────────────────────────────
# Current checkout supports cash and manual M-Pesa/EcoCash proof
# submission. Do not put wallet PINs or customer secrets in this file.
#
# Live mobile-money collection requires a merchant account and provider
# credentials/webhooks from Vodacom M-Pesa or a licensed Lesotho PSP.
# The server-side adapters remain disabled until these values are configured.
# Never put wallet PINs or customer secrets here.
# MPESA_ENVIRONMENT=sandbox
# MPESA_MARKET=vodacomLES
# MPESA_COUNTRY=LES
# MPESA_CURRENCY=LSL
# MPESA_API_KEY=replace-with-approved-m-pesa-api-key
# MPESA_PUBLIC_KEY=replace-with-public-key-for-the-target-environment
# MPESA_SERVICE_PROVIDER_CODE=replace-with-u-go-merchant-short-code
# MPESA_BASE_URL=https://openapi.m-pesa.com/sandbox/ipg/v2
# MPESA_ORIGIN=*
# MPESA_SESSION_TTL_SECONDS=300
# MPESA_PAYMENTS_URL=https://approved-m-pesa-c2b-endpoint.example
# MPESA_QUERY_URL=https://approved-m-pesa-query-endpoint.example
# MPESA_REVERSAL_URL=https://approved-m-pesa-reversal-endpoint.example
# MPESA_WEBHOOK_SECRET=replace-with-webhook-signing-secret
# ECOCASH_PAYMENTS_URL=https://approved-ecocash-endpoint.example/collect
# ECOCASH_API_KEY=replace-with-approved-ecocash-api-key
# ECOCASH_WEBHOOK_SECRET=replace-with-webhook-signing-secret
# PAYMENTS_CALLBACK_BASE_URL=https://api.example.com
